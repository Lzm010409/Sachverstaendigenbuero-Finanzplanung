// Liquiditätsplanung – Datenmodell
// Geldbeträge werden IMMER als Ganzzahl in Cent gespeichert (Int), niemals als Float.
// Vorzeichen: positiv = Zufluss (Einnahme), negativ = Abfluss (Ausgabe).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CHECKING // Girokonto
  SAVINGS // Sparkonto / Tagesgeld
  CASH // Kasse
  CREDIT // Kreditlinie / Kreditkarte
}

enum CategoryKind {
  INCOME
  EXPENSE
}

// Rhythmus, in dem ein Kategorie-Budget erfasst/angezeigt wird. Intern bleibt
// der Jahreswert (annualBudget) die Normalisierung.
enum BudgetPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum Recurrence {
  ONCE
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RuleField {
  COUNTERPARTY // Empfänger/Auftraggeber
  PURPOSE // Verwendungszweck
}

enum RuleAmountOp {
  GT // größer als
  LT // kleiner als
  GTE // größer/gleich
  LTE // kleiner/gleich
  EQ // gleich
}

enum OpenItemKind {
  RECEIVABLE // Forderung (wir erhalten Geld)
  PAYABLE // Verbindlichkeit (wir zahlen)
}

// Einfacher Schlüssel-Wert-Speicher für App-Einstellungen (Integrationen etc.).
// Hier werden u.a. Integrations-Zugangsdaten (Token/Domain) abgelegt.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum ContactType {
  PERSON
  ORG
}

// Aus Pipedrive synchronisierter Kontakt (Person oder Organisation).
model Contact {
  id         String      @id @default(cuid())
  source     String      @default("pipedrive")
  externalId String
  type       ContactType
  name       String
  email      String?
  orgName    String?
  updatedAt  DateTime    @updatedAt

  @@unique([source, externalId])
  @@index([name])
}

model Account {
  id             String        @id @default(cuid())
  name           String
  type           AccountType   @default(CHECKING)
  iban           String?
  // Externe ID zur Zuordnung bei Integrationen (z.B. sevDesk CheckAccount-ID).
  externalId     String?
  source         String? // Herkunft, z.B. "sevdesk"
  // Wenn true: Konto bleibt sichtbar/synchronisiert, zählt aber NICHT in
  // Saldo, Forecast, Auswertung und Kennzahlen (z.B. Dummy-/Nebenkonten).
  excludedFromCalc Boolean     @default(false)
  currency       String        @default("EUR")
  // Anfangssaldo in Cent zum Startdatum (alles davor ist im Saldo bereits enthalten)
  openingBalance Int           @default(0)
  openingDate    DateTime      @default(now())
  archived       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  transactions   Transaction[]
  plannedItems   PlannedItem[]

  @@index([archived])
}

model Category {
  id           String        @id @default(cuid())
  name         String
  kind         CategoryKind
  color        String        @default("#64748b")
  parentId     String?
  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]    @relation("CategoryTree")
  rules        Rule[]
  transactions Transaction[]
  plannedItems PlannedItem[]
  openItems    OpenItem[]
  budgets      Budget[]
  scenarioAdjustments ScenarioCategoryAdjustment[]
  // Neutral / durchlaufend: Konto-zu-Konto-Transfers (Geldtransfer). Solche
  // Umsätze zählen NICHT als Einnahme/Ausgabe (über alle Konten netto null),
  // bleiben aber im Kontostand. Steuern sind KEIN Transfer (echter Abfluss).
  isTransfer   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  // Soft-Delete: gesetzt = gelöscht (30 Tage wiederherstellbar, danach endgültig).
  deletedAt    DateTime?

  @@index([kind])
  @@index([deletedAt])
}

// Budget / geplante Ausgabe – bewusst von der Kategorie ENTKOPPELT (eigenes
// Objekt mit Titel, Betrag, Rhythmus und optionalem Gültigkeitszeitraum). Die
// Verknüpfung zu einer Kategorie ist optional; mehrere Budgets je Kategorie sind
// möglich. Betrag wird je Periode (period) erfasst und positiv gespeichert.
model Budget {
  id          String       @id @default(cuid())
  title       String
  kind        CategoryKind
  amount      Int          @default(0) // Cent, positiv, je Periode
  period      BudgetPeriod @default(MONTHLY)
  startDate   DateTime? // Gültig ab (optional)
  endDate     DateTime? // Gültig bis (optional)
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  note        String?
  active      Boolean      @default(true)
  // Wenn true: fließt als wiederkehrender Planposten (im Rhythmus, innerhalb des
  // Zeitraums) in die Liquiditätsprognose ein. Standard aus, um Doppelzählung mit
  // echten Umsätzen/Planposten zu vermeiden.
  includeInForecast Boolean @default(false)
  createdAt   DateTime     @default(now())
  // Soft-Delete: 30 Tage wiederherstellbar, danach endgültig.
  deletedAt   DateTime?

  @@index([kind])
  @@index([categoryId])
  @@index([active])
  @@index([deletedAt])
}

// Regel zur automatischen Kategorisierung importierter Umsätze.
model Rule {
  id          String        @id @default(cuid())
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  field       RuleField     @default(PURPOSE)
  // Freitext, der (case-insensitive) im Feld enthalten sein muss. Optional als /regex/.
  // Kann leer sein, wenn die Regel nur über den Betrag greift.
  pattern     String?
  // Optionale Betrags-Bedingung (vorzeichenbehaftet, in Cent).
  amountOp    RuleAmountOp?
  amountValue Int?
  priority    Int           @default(100) // kleiner = wird zuerst geprüft
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())

  @@index([active, priority])
}

model Transaction {
  id           String    @id @default(cuid())
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bookingDate  DateTime
  valueDate    DateTime?
  amount       Int // Cent, vorzeichenbehaftet
  counterparty String    @default("")
  purpose      String    @default("")
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Deduplizierung beim Import: Hash aus Konto+Datum+Betrag+Zweck+Gegenpartei
  importHash   String    @unique
  createdAt    DateTime  @default(now())

  @@index([accountId, bookingDate])
  @@index([categoryId])
}

// Geplante (wiederkehrende oder einmalige) Ein-/Auszahlung für die Vorschau.
model PlannedItem {
  id          String      @id @default(cuid())
  name        String
  accountId   String?
  account     Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  amount      Int // Cent, vorzeichenbehaftet
  recurrence  Recurrence  @default(MONTHLY)
  interval    Int         @default(1) // z.B. alle 2 Monate => MONTHLY, interval 2
  startDate   DateTime
  endDate     DateTime? // optional, offen wenn null
  active      Boolean     @default(true)
  note        String?
  createdAt   DateTime    @default(now())

  @@index([active])
}

// Offener Posten: unbezahlte Forderung/Verbindlichkeit mit Fälligkeit.
// Fließt bis zur Bezahlung als erwarteter Zu-/Abfluss in die Vorschau ein.
model OpenItem {
  id           String       @id @default(cuid())
  kind         OpenItemKind
  counterparty String       @default("")
  reference    String? // z.B. Rechnungsnummer
  externalId   String? // ID im Quellsystem (z.B. sevDesk)
  source       String? // Herkunft, z.B. "sevdesk-invoice" / "sevdesk-voucher"
  amount       Int // Cent, immer positiv (Bruttobetrag); Richtung ergibt sich aus kind
  paidAmount   Int          @default(0) // bereits bezahlter Anteil in Cent (Teilzahlung)
  issueDate    DateTime?
  dueDate      DateTime
  paid         Boolean      @default(false)
  paidDate     DateTime?
  // Mahnstufe (0 = keine, 1 = Zahlungserinnerung, 2 = 1. Mahnung, 3 = 2. Mahnung/Inkasso)
  reminderLevel Int         @default(0)
  categoryId   String?
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  note         String?
  createdAt    DateTime     @default(now())

  @@unique([source, externalId])
  @@index([paid, dueDate])
}

// Monatlicher Forecast-Snapshot: Zum Monatsanfang wird die für ein Zieldatum
// prognostizierte Liquidität festgehalten. Später wird der Ist-Wert nachgetragen,
// um die Prognosegüte auszuwerten.
model ForecastSnapshot {
  id                  String   @id @default(cuid())
  takenOn             DateTime @default(now()) // wann der Snapshot erstellt wurde
  targetMonth         String // Zielmonat "YYYY-MM"
  horizonDays         Int // Prognosehorizont in Tagen
  projectedLiquidity  Int // prognostizierte Liquidität (Cent) für den Zielmonat
  actualLiquidity     Int? // tatsächliche Liquidität (Cent), nachgetragen
  createdAt           DateTime @default(now())

  @@unique([targetMonth, horizonDays])
  @@index([takenOn])
}

// --- OAuth 2.1 (App-eigener Authorization Server für den MCP-Connector) ---------
// Die App ist ihr eigener OAuth-Server. claude.ai registriert sich dynamisch
// (DCR, RFC 7591) als öffentlicher Client und nutzt Authorization-Code + PKCE.
// Zugriffstokens sind signierte JWTs (HS256), Refresh-Tokens werden hier als
// Hash abgelegt. Kein Client-Secret (öffentlicher Client, token_auth = none).

model OAuthClient {
  id                      String   @id @default(cuid())
  clientName              String?
  // Erlaubte Redirect-URIs (JSON-Array als String).
  redirectUris            String
  // token_endpoint_auth_method, i.d.R. "none" (öffentlicher Client + PKCE).
  tokenEndpointAuthMethod String   @default("none")
  grantTypes              String   @default("authorization_code,refresh_token")
  scope                   String?
  createdAt               DateTime @default(now())

  codes  OAuthCode[]
  tokens OAuthToken[]
}

// Kurzlebiger Authorization-Code (Single-Use, ~10 min) inkl. PKCE-Challenge.
model OAuthCode {
  id                  String      @id @default(cuid())
  code                String      @unique
  clientId            String
  client              OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  redirectUri         String
  scope               String      @default("")
  codeChallenge       String
  codeChallengeMethod String      @default("S256")
  resource            String?
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime    @default(now())

  @@index([expiresAt])
}

// Refresh-Token (als SHA-256-Hash gespeichert). Zugriffstokens sind zustandslose
// JWTs und werden NICHT gespeichert.
model OAuthToken {
  id             String      @id @default(cuid())
  refreshHash    String      @unique
  clientId       String
  client         OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scope          String      @default("")
  resource       String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime    @default(now())

  @@index([expiresAt])
}

// Szenario zur Simulation (Best/Base/Worst). Wirkt multiplikativ auf geplante
// Zu-/Abflüsse und offene Posten und kann Zuflüsse zeitlich verzögern.
model Scenario {
  id                 String                       @id @default(cuid())
  name               String
  inflowFactor       Float                        @default(1.0) // globaler Faktor auf Zuflüsse
  outflowFactor      Float                        @default(1.0) // globaler Faktor auf Abflüsse
  inflowShiftDays    Int                          @default(0) // Zuflüsse um n Tage nach hinten schieben
  isDefault          Boolean                      @default(false)
  categoryAdjustments ScenarioCategoryAdjustment[]
  createdAt          DateTime                     @default(now())
}

// Kategoriespezifischer Faktor innerhalb eines Szenarios (überschreibt den
// globalen Faktor für Beträge dieser Kategorie).
model ScenarioCategoryAdjustment {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  factor     Float    @default(1.0)

  @@unique([scenarioId, categoryId])
}
