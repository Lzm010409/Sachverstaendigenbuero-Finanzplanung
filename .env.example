# --- Datenbank ---
# Wird von docker-compose gesetzt; lokal ohne Docker z.B.:
DATABASE_URL="postgresql://liqui:liqui@localhost:5432/liqui?schema=public"

# --- Auth.js (NextAuth v5) ---
# Signaturgeheimnis für Sessions (z.B. `openssl rand -hex 32`)
AUTH_SECRET="bitte-32-byte-zufallswert-eintragen"
# Öffentliche URL der App (hinter Reverse-Proxy/Cloudflare)
AUTH_URL="https://finance.gollenstede.app"
AUTH_TRUST_HOST="true"

# Passwort-Fallback-Login (aktiv, solange kein Microsoft-SSO konfiguriert ist)
APP_PASSWORD="bitte-aendern"

# --- Microsoft Entra ID (SSO), optional ---
# Aus der App-Registrierung im Entra Admin Center:
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Issuer inkl. Tenant-ID:
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<TENANT_ID>/v2.0"
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
