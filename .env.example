# --- Datenbank ---
# Wird von docker-compose gesetzt; lokal ohne Docker z.B.:
DATABASE_URL="postgresql://liqui:liqui@localhost:5432/liqui?schema=public"

# --- Single-User-Login ---
# Passwort für den Zugang zur App
APP_PASSWORD="bitte-aendern"
# Zufälliger Schlüssel zum Signieren des Session-Cookies (z.B. `openssl rand -hex 32`)
AUTH_SECRET="bitte-32-byte-zufallswert-eintragen"
